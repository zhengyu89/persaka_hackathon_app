                                          selectedHackathonName =
                                              hackathon[
                                                  "name"];

                                          selectedTeams =
                                              [];
                                        }
                                      });
                                    },

                                    child:
                                        Padding(

                                      padding:
                                          const EdgeInsets.all(
                                              18),

                                      child:
                                          Row(

                                        children: [

                                          Container(

