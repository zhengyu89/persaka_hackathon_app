                                  if (isSelected)

                                    Padding(

                                      padding:
                                          const EdgeInsets.fromLTRB(
                                        18,
                                        0,
                                        18,
                                        18,
                                      ),

                                      child:
                                          Column(

                                        children: [

                                          const Divider(),

                                          ...teams.map<Widget>(

                                            (team) {

                                              final bool
                                                  alreadySelected =
                                                  selectedTeams.any(

                                                (e) =>

                                                    e["teamId"] ==
                                                    team["id"],
                                              );

                                              final bool
