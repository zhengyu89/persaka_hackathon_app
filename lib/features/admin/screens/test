                                      setModalState(() {

                                        if (isSelected) {

                                          selectedHackathonId =
                                              null;

                                          selectedHackathonName =
                                              null;

                                          selectedTeams =
                                              [];

                                        } else {

                                          selectedHackathonId =
                                              hackathon[
