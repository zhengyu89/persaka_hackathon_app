                                                                          0xFFEDE9FE),

                                                                  borderRadius:
                                                                      BorderRadius.circular(
                                                                          20),
                                                                ),

                                                                child:
                                                                    Text(

                                                                  alreadyAssigned

                                                                      ? "Assigned"

                                                                      : "Available",

                                                                  style:
                                                                      TextStyle(

                                                                    color: alreadyAssigned

                                                                        ? const Color(
                                                                            0xFF166534)

