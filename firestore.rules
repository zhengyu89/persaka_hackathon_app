rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isJudge() {
      return userRole() == 'judge';
    }

    match /hackathons/{hackathonId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /criteria/{criterionId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }

      match /judges/{judgeUid} {
        allow read: if isAdmin() || (isJudge() && request.auth.uid == judgeUid);
        allow write: if isAdmin();
      }

      match /scores/{scoreId} {
        allow read: if isAdmin() || isJudge();
        allow create, update: if isJudge()
          && request.resource.data.judgeUid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
